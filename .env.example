# ==============================================================================
# Anot Medical ASR — Production Service Environment Configuration
# ==============================================================================

# Hardware Device: cpu (default) or xpu (Intel Arc GPU)
ANOT_ASR_DEVICE=cpu

# Foundation Model ID (cached locally in Hugging Face cache)
ANOT_ASR_MODEL_ID=google/medasr

# ------------------------------------------------------------------------------
# ASR ENGINE SELECTION
# ------------------------------------------------------------------------------
# whisper = Whisper large-v3 (RECOMMENDED for patient-visit recordings).
#           Best accuracy on conversational audio (~97% clinical), local, batch.
# medasr  = Google MedASR (dictation-only; fast, repo default for offline tests).
ANOT_ASR_ENGINE=whisper
ANOT_WHISPER_MODEL=large-v3
ANOT_WHISPER_DEVICE=cpu
# int8 (fastest/smallest on CPU), int8_float16, float16 (GPU), float32 (most accurate)
ANOT_WHISPER_COMPUTE_TYPE=int8
ANOT_WHISPER_BEAM_SIZE=5
ANOT_WHISPER_LANGUAGE=en
# Optional clinical context prompt that biases Whisper toward medical spelling.
# ANOT_WHISPER_INITIAL_PROMPT=Clinical encounter. Medications, dosages, vital signs, diagnoses discussed.
# Hotwords: leave empty to auto-load the clinic vocabulary mined from local notes
# (language_model/models/medical_hotwords.txt), or set a space-separated list.
# ANOT_WHISPER_HOTWORDS=
# Anti-hallucination thresholds (raise no-speech to drop more silence hallucinations).
ANOT_WHISPER_NO_SPEECH_THRESHOLD=0.6
ANOT_WHISPER_LOGPROB_THRESHOLD=-1.0
ANOT_WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
ANOT_WHISPER_LOW_CONFIDENCE_LOGPROB=-0.8

# ------------------------------------------------------------------------------
# AUDIO FRONT-END ENHANCEMENT (label-free accuracy lever, applied before ASR)
# ------------------------------------------------------------------------------
ANOT_AUDIO_ENHANCE=true
ANOT_AUDIO_HIGHPASS=true
ANOT_AUDIO_HIGHPASS_HZ=70.0
ANOT_AUDIO_LOUDNESS_NORM=true
ANOT_AUDIO_TARGET_DBFS=-20.0
# Spectral-gate denoise (requires `noisereduce`). Off by default: can help noisy
# rooms but may hurt clean audio — validate with benchmark/stage23 before enabling.
ANOT_AUDIO_DENOISE=false

# Service Environment: development, staging, production
ANOT_ASR_ENV=development
ANOT_ASR_DEBUG=false

# Network Binding (Private / Localhost by default)
ANOT_ASR_HOST=127.0.0.1
ANOT_ASR_PORT=8000
ANOT_ASR_API_PREFIX=/api/v1

# Default Inference Settings
ANOT_ASR_MODE_DEFAULT=dictation
ANOT_ASR_DECODER_DEFAULT=greedy
ANOT_ASR_BEAM_WIDTH=4
ANOT_ASR_LM_ENABLED=false
ANOT_ASR_LM_WEIGHT=0.05
ANOT_ASR_MEDICAL_WEIGHT=0.05
ANOT_ASR_NORMALIZE=true

# Resource Protection & Throttling Limits
ANOT_ASR_MAX_UPLOAD_MB=500
ANOT_ASR_MAX_DURATION_SECONDS=14400.0
ANOT_ASR_MAX_CONCURRENT_JOBS=2

# Temporary Audio Directory
ANOT_ASR_TEMP_DIR=temp/asr_uploads

# Security / Authentication. Set in production to require an X-API-Key header
# on transcription endpoints.
# ANOT_ASR_API_KEY=your_secure_internal_api_key_here

# Allowed CORS origins (comma-separated). Set to your web app's domain(s) in prod.
# ANOT_CORS_ORIGINS=https://your-app.example.com
